@{
    ViewData["Title"] = "Attendance Monitoring";
    // ✅ TIMEZONE FIX: Calculate Philippine local time (UTC+8)
    var philippineTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time");
    var philippineToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, philippineTimeZone).Date;
    var philippineTodayString = philippineToday.ToString("yyyy-MM-dd");
}

<div class="page-header">
    <h1 class="page-title">Attendance Monitoring</h1>
    <div class="header-actions">
        <div class="class-selector">
            <select id="classSelect" class="form-select">
                <option value="">Select a class...</option>
            </select>
        </div>
        <div class="date-selector">
            <input type="date" id="dateSelect" class="form-control" max="@philippineTodayString" value="@philippineTodayString" />
        </div>
        <button type="button" class="btn btn-warning" id="btnProcessForgotTimeout" disabled title="Check for students who forgot to time out">
            <i data-lucide="alert-triangle" class="icon-sm"></i>
            Check Forgot Timeout
        </button>
        <button type="button" class="btn btn-primary" id="btnMarkAllPresent" disabled>
            Mark All Present
        </button>
    </div>
</div>

<div class="card" id="attendanceCard" style="display: none;">
    <div class="card-header">
        <h2 class="card-title" id="classTitle">Class Attendance</h2>
        <p class="card-subtitle" id="classSubtitle">Select a date to view attendance</p>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="attendanceTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Student Number</th>
                        <th>Name</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="empty-state-card" id="emptyState">
    <i data-lucide="clipboard-list"></i>
    <h3>Select a Class</h3>
    <p>Please select a class from the dropdown to view attendance</p>
</div>

<!-- Edit Attendance Modal -->
<div class="modal fade" id="editAttendanceModal" tabindex="-1" aria-labelledby="editAttendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editAttendanceModalLabel">Edit Attendance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editAttendanceForm">
                    <input type="hidden" id="editStudId">
                    <div class="mb-3">
                        <label class="form-label">Student</label>
                        <input type="text" class="form-control" id="editStudentName" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="editStatus" class="form-label">Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="editStatus" required>
                            <option value="Present">Present</option>
                            <option value="Late">Late</option>
                            <option value="Absent">Absent</option>
                            <option value="Excused">Excused</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="editRemarks" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateAttendance">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Attendance
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAttendanceModal" tabindex="-1" aria-labelledby="deleteAttendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteAttendanceModalLabel">Delete Attendance Record?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this attendance record?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteStudId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/date-picker-validation.js" asp-append-version="true"></script>
    <script src="~/js/faculty/faculty_attendance.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/faculty/faculty_attendance.css" asp-append-version="true"/>
