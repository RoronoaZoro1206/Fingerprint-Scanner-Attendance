@{
    ViewData["Title"] = "Attendance Reports";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Attendance Reports</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid" id="statsGrid">
    <!-- Stats will be loaded here -->
</div>

<!-- Recent Attendance History -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Recent Attendance History</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="attendanceTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Class</th>
                        <th>Present</th>
                        <th>Late</th>
                        <th>Absent</th>
                        <th>Excused</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/faculty_record.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/faculty_record.css" asp-append-version="true"/>
