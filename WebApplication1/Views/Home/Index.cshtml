@{
    ViewData["Title"] = "Home Page";
}

<div class="home-container">
    <div class="home-content">
        <!-- Left Side: Fingerprint Scanner -->
        <div class="scanner-section">
            <div class="fingerprint-container" id="fingerprintScanner">
                <div class="scanner-instruction-text">Place finger here</div>
            </div>
            
            <h1 class="scanner-title">Scan your fingerprint to log your attendance</h1>
            
            <ul class="scanner-instructions">
                <li>Place your finger on the physical scanner</li>
                <li>The system will automatically detect your fingerprint</li>
            </ul>
            
            <div class="scan-status-message" id="scanStatusMessage"></div>
        </div>

        <!-- Right Side: Live Scan Results -->
        <div class="results-section">
            <div class="results-header">
                <div class="results-title-group">
                    <h2>Live Scan Results</h2>
                    <p>Recent attendance records</p>
                </div>
                <div class="results-time">
                    <span class="time" id="current-time">10:22:15 AM</span>
                    <span class="date" id="current-date">10/07/2025</span>
                </div>
            </div>

            <!-- Recent Scan Record -->
            <div class="scan-record">
                <div class="scan-status-row">
                    <span class="scan-status">TIME IN</span>
                    <span class="scan-time">09:58:00 AM</span>
                </div>
                
                <div class="scan-user">
                    <i data-lucide="user" style="color: #ea580c;"></i>
                    <div class="scan-class-info">
                        <h3>Kevin Harris</h3>
                        <p>Student</p>
                    </div>
                </div>
                
                <div class="scan-class">
                    <i data-lucide="calendar" style="color: #ea580c;"></i>
                    <div class="scan-class-info">
                        <h4>ENG101 - Engineering Mathematics</h4>
                        <p>Class</p>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="scan-stats">
                <div class="scan-stat-card success">
                    <h3>98.5%</h3>
                    <p>Success Rate</p>
                </div>
                <div class="scan-stat-card total">
                    <h3>1,247</h3>
                    <p>Today's Scans</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Modern home page scanner - White background with colored border */
    .fingerprint-container {
    background: #ffffff !important; /* Pure white background */
   border: 3px solid #e5e7eb !important; /* Gray border */
   cursor: pointer;
        transition: all 0.3s ease;
    }

    .fingerprint-container:hover {
   background: #ffffff !important; /* Keep white */
        border-color: #3b82f6 !important; /* Blue border */
 }

    .fingerprint-container.scanning {
background: #ffffff !important; /* Keep white */
        border-color: #3b82f6 !important; /* Blue border */
   border-width: 4px !important;
   animation: pulse 1.5s infinite;
    }

    .fingerprint-container.success {
    background: #ffffff !important; /* Keep white */
   border-color: #10b981 !important; /* Green border */
        border-width: 4px !important;
    }

    .fingerprint-container.error {
  background: #ffffff !important; /* Keep white */
        border-color: #ef4444 !important; /* Red border */
border-width: 4px !important;
    }

    .scanner-instruction-text {
        font-size: 1.2rem;
        color: rgba(107, 114, 128, 0.6);
      font-weight: 500;
    text-align: center;
    }

    .fingerprint-container.scanning .scanner-instruction-text {
        color: rgba(59, 130, 246, 0.9);
    }

 /* Fingerprint image - black on white */
    .fingerprint-container img {
 max-width: 90%;
        max-height: 90%;
  object-fit: contain;
        border-radius: 50%;
    filter: contrast(1.2) brightness(1.1);
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
       border-color: #3b82f6;
        }
 50% {
    transform: scale(1.02);
   border-color: #2563eb;
        }
    }
</style>


