@{
    ViewData["Title"] = "Home Page";
}

<div class="home-container">
    <div class="home-content">
        <!-- Left Side: Fingerprint Scanner -->
        <div class="scanner-section">
            <div class="fingerprint-container" id="fingerprintScanner">
                <div class="scanner-instruction-text">Place finger here</div>
            </div>
            
            <h1 class="scanner-title">Scan your fingerprint to log your attendance</h1>
            
            <ul class="scanner-instructions">
                <li>Place your finger on the physical scanner</li>
                <li>The system will automatically detect your fingerprint</li>
            </ul>
            
            <!-- ✅ VISIBLE: Status message box for scanner initialization/status -->
            <div class="scan-status-message" id="scanStatusMessage"></div>
            
            <!-- ✅ NEW: Live Student Info Cards -->
            <div class="student-info-cards" id="studentInfoCards" style="display: none;">
                <div class="info-card">
                    <div class="info-label">Student</div>
                    <div class="info-value" id="currentStudentName">-</div>
                    <div class="info-subtitle" id="currentStudentNumber">-</div>
                </div>
                
                <div class="info-card">
                    <div class="info-label">Program</div>
                    <div class="info-value" id="currentProgram">-</div>
                    <div class="info-subtitle" id="currentYearSection">-</div>
                </div>
                
                <div class="info-card">
                    <div class="info-label">Current Class</div>
                    <div class="info-value" id="currentCourse">-</div>
                    <div class="info-subtitle" id="currentRoom">-</div>
                </div>
                
                <div class="info-card">
                    <div class="info-label">Faculty</div>
                    <div class="info-value" id="currentFaculty">-</div>
                    <div class="info-subtitle" id="currentSchedule">-</div>
                </div>
            </div>
        </div>

        <!-- Right Side: Live Scan Results -->
        <div class="results-section">
            <div class="results-header">
                <div class="results-title-group">
                    <h2>Live Scan Results</h2>
                    <p>Recent attendance records</p>
                </div>
                <div class="results-time">
                    <span class="time" id="current-time">--:--:-- --</span>
                    <span class="date" id="current-date">--/--/----</span>
                </div>
            </div>

            <!-- ✅ NEW: Live Scan Info Section (shows after successful scan) -->
            <div class="live-scan-info-container" id="liveScanInfoContainer" style="display: none;">
                <!-- Action Badge (TIME IN / TIME OUT) -->
                <div class="scan-action-badge time-in" id="scanActionBadge">
                    <span id="scanActionText">TIME IN</span>
                    <span class="scan-time" id="scanActionTime">--:--:-- --</span>
                </div>

                <!-- Student Info Card -->
                <div class="live-info-card">
                    <div class="info-icon user-icon">
                        <i data-lucide="user" style="width: 20px; height: 20px;"></i>
                    </div>
                    <div class="info-details">
                        <div class="info-value" id="liveStudentName">-</div>
                        <div class="info-label">Student</div>
                    </div>
                </div>

                <!-- Course Info Card -->
                <div class="live-info-card">
                    <div class="info-icon course-icon">
                        <i data-lucide="book-open" style="width: 20px; height: 20px;"></i>
                    </div>
                    <div class="info-details">
                        <div class="info-value" id="liveCourseName">-</div>
                        <div class="info-label">Class</div>
                    </div>
                </div>

                <!-- Faculty Info Card -->
                <div class="live-info-card">
                    <div class="info-icon faculty-icon">
                        <i data-lucide="user-check" style="width: 20px; height: 20px;"></i>
                    </div>
                    <div class="info-details">
                        <div class="info-value" id="liveFacultyName">-</div>
                        <div class="info-label">Faculty</div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="scan-stats">
                <div class="scan-stat-card success">
                    <h3>0%</h3>
                    <p>Success Rate</p>
                </div>
                <div class="scan-stat-card total">
                    <h3>0</h3>
                    <p>Today's Scans</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audio for scan feedback -->
