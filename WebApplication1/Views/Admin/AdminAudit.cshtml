@{
    ViewData["Title"] = "Audit Logs";
}

<link rel="stylesheet" href="~/css/admin_audit.css" />

<div class="page-header">
    <h1 class="page-title">Audit Logs</h1>
</div>

<!-- Statistics Cards -->
<div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon total">
                <i data-lucide="file-text"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="totalLogs">0</div>
                <div class="stat-label">Total Logs</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon today">
                <i data-lucide="calendar"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="todayLogs">0</div>
                <div class="stat-label">Today</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon week">
                <i data-lucide="calendar-days"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="weekLogs">0</div>
                <div class="stat-label">This Week</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon month">
                <i data-lucide="calendar-range"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="monthLogs">0</div>
                <div class="stat-label">This Month</div>
            </div>
        </div>
    </div>

<!-- Audit Logs Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="auditTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Admin</th>
                        <th>Admin Code</th>
                        <th>Action</th>
                        <th>Details</th>
                        <th>Date & Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewModalLabel">
                    <i data-lucide="eye"></i>
                    Audit Log Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="detail-group">
                    <label class="detail-label">Log ID:</label>
                    <div class="detail-value" id="viewAudId"></div>
                </div>
                <div class="detail-group">
                    <label class="detail-label">Administrator:</label>
                    <div class="detail-value" id="viewAdminName"></div>
                </div>
                <div class="detail-group">
                    <label class="detail-label">Admin Code:</label>
                    <div class="detail-value" id="viewAdminCode"></div>
                </div>
                <div class="detail-group">
                    <label class="detail-label">Action:</label>
                    <div class="detail-value" id="viewAction"></div>
                </div>
                <div class="detail-group">
                    <label class="detail-label">Details:</label>
                    <div class="detail-value" id="viewDetails"></div>
                </div>
                <div class="detail-group">
                    <label class="detail-label">Date & Time:</label>
                    <div class="detail-value" id="viewDateTime"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAuditModal" tabindex="-1" aria-labelledby="deleteAuditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteAuditModalLabel">Delete Audit Log?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this audit log?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteAudId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin_audit.js"></script>
}
