@{
    ViewData["Title"] = "Students";
}

<div class="page-header">
    <h1 class="page-title">Manage Students</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddStudent">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Student
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="studentsTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Student Number</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Program</th>
                        <th>Year Level</th>
                        <th>Section</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addStudentModalLabel">Add New Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addStudentForm">
                    <div class="mb-3">
                        <label for="addUserId" class="form-label">Student User <span class="text-danger">*</span></label>
                        <select class="form-select" id="addUserId" name="UserId" required>
                            <option value="">Select a user...</option>
                        </select>
                        <div class="form-text">Select a user with Student role</div>
                    </div>
                    <div class="mb-3">
                        <label for="addStudNumber" class="form-label">Student Number <span class="text-danger">*</span></label>
                        <div class="student-id-search-wrapper">
                            <input type="text" class="form-control" id="addStudNumber" name="StudNumber" 
                                   placeholder="Search student ID..." autocomplete="off" required>
                            <div class="student-id-dropdown" id="addStudNumberDropdown"></div>
                        </div>
                        <div class="form-text">Type to search available student IDs (max 10 results)</div>
                    </div>
                    <div class="mb-3">
                        <label for="addProgramId" class="form-label">Program</label>
                        <select class="form-select" id="addProgramId" name="ProgramId">
                            <option value="">No Program</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addStudYearLevel" class="form-label">Year Level</label>
                        <select class="form-select" id="addStudYearLevel" name="StudYearLevel">
                            <option value="">Select Year Level</option>
                            <option value="1">1st Year</option>
                            <option value="2">2nd Year</option>
                            <option value="3">3rd Year</option>
                            <option value="4">4th Year</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addSectionId" class="form-label">Section</label>
                        <select class="form-select" id="addSectionId" name="SectionId">
                            <option value="">No Section</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveStudent">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Student
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1" aria-labelledby="editStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editStudentModalLabel">Edit Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editStudentForm">
                    <input type="hidden" id="editStudId" name="StudId">
                    <input type="hidden" id="editUserId" name="UserId">
                    <div class="mb-3">
                        <label for="editUserEmail" class="form-label">Student User</label>
                        <input type="text" class="form-control" id="editUserEmail" readonly disabled>
                        <div class="form-text">User cannot be changed</div>
                    </div>
                    <div class="mb-3">
                        <label for="editStudNumber" class="form-label">Student Number <span class="text-danger">*</span></label>
                        <div class="student-id-search-wrapper">
                            <input type="text" class="form-control" id="editStudNumber" name="StudNumber" 
                                   placeholder="Search student ID..." autocomplete="off" required>
                            <div class="student-id-dropdown" id="editStudNumberDropdown"></div>
                        </div>
                        <div class="form-text">Type to search available student IDs (max 10 results)</div>
                    </div>
                    <div class="mb-3">
                        <label for="editProgramId" class="form-label">Program</label>
                        <select class="form-select" id="editProgramId" name="ProgramId">
                            <option value="">No Program</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editStudYearLevel" class="form-label">Year Level</label>
                        <select class="form-select" id="editStudYearLevel" name="StudYearLevel">
                            <option value="">Select Year Level</option>
                            <option value="1">1st Year</option>
                            <option value="2">2nd Year</option>
                            <option value="3">3rd Year</option>
                            <option value="4">4th Year</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editSectionId" class="form-label">Section</label>
                        <select class="form-select" id="editSectionId" name="SectionId">
                            <option value="">No Section</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateStudent">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Student
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1" aria-labelledby="deleteStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteStudentModalLabel">Delete Student?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this student record?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteStudId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/student.css" asp-append-version="true"/>
