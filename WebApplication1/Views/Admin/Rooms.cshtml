@{
    ViewData["Title"] = "Rooms";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Manage Rooms</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddRoom">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Room
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="roomsTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Room Code</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRoomModalLabel">Add New Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addRoomForm">
                    <div class="mb-3">
                        <label for="addRoomCode" class="form-label">Room Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addRoomCode" name="RoomCode" required maxlength="20">
                        <div class="form-text">e.g., R101, LAB-A, GYM</div>
                    </div>
                    <div class="mb-3">
                        <label for="addRoomDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="addRoomDescription" name="RoomDescription" rows="3" maxlength="200"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveRoom">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Room
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal fade" id="editRoomModal" tabindex="-1" aria-labelledby="editRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRoomModalLabel">Edit Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editRoomForm">
                    <input type="hidden" id="editRoomId" name="RoomId">
                    <div class="mb-3">
                        <label for="editRoomCode" class="form-label">Room Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editRoomCode" name="RoomCode" required maxlength="20">
                    </div>
                    <div class="mb-3">
                        <label for="editRoomDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editRoomDescription" name="RoomDescription" rows="3" maxlength="200"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateRoom">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Room
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteRoomModal" tabindex="-1" aria-labelledby="deleteRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteRoomModalLabel">Delete Room?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this room?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteRoomId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/room.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/room.css" asp-append-version="true"/>
