@{
    ViewData["Title"] = "Academic Terms";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Manage Academic Terms</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddTerm">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Term
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="termsTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Term Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Term Modal -->
<div class="modal fade" id="addTermModal" tabindex="-1" aria-labelledby="addTermModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTermModalLabel">Add New Academic Term</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addTermForm">
                    <div class="mb-3">
                        <label for="addTermName" class="form-label">Term Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addTermName" name="TermName" required maxlength="100">
                        <div class="form-text">e.g., 1st Semester AY 2025-2026</div>
                    </div>
                    <div class="mb-3">
                        <label for="addStartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="addStartDate" name="StartDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="addEndDate" class="form-label">End Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="addEndDate" name="EndDate" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="addIsActive" name="IsActive">
                            <label class="form-check-label" for="addIsActive">
                                Set as Active Term
                            </label>
                            <div class="form-text">Only one term can be active at a time</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveTerm">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Term
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Term Modal -->
<div class="modal fade" id="editTermModal" tabindex="-1" aria-labelledby="editTermModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTermModalLabel">Edit Academic Term</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editTermForm">
                    <input type="hidden" id="editTermId" name="TermId">
                    <div class="mb-3">
                        <label for="editTermName" class="form-label">Term Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editTermName" name="TermName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="editStartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="editStartDate" name="StartDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="editEndDate" class="form-label">End Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="editEndDate" name="EndDate" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive">
                            <label class="form-check-label" for="editIsActive">
                                Set as Active Term
                            </label>
                            <div class="form-text">Only one term can be active at a time</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateTerm">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Term
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteTermModal" tabindex="-1" aria-labelledby="deleteTermModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteTermModalLabel">Delete Academic Term?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this academic term?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteTermId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/academic_term.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/academic_term.css" asp-append-version="true"/>
