@{
    ViewData["Title"] = "Programs";
}

<div class="page-header">
    <h1 class="page-title">Manage Programs</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddProgram">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Program
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="programsTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Program Modal -->
<div class="modal fade" id="addProgramModal" tabindex="-1" aria-labelledby="addProgramModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addProgramModalLabel">Add New Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addProgramForm">
                    <div class="mb-3">
                        <label for="addProgramCode" class="form-label">Program Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addProgramCode" name="ProgramCode" required maxlength="10">
                        <div class="form-text">e.g., BSCS, BSIT, BSENG</div>
                    </div>
                    <div class="mb-3">
                        <label for="addProgramName" class="form-label">Program Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addProgramName" name="ProgramName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="addProgramDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="addProgramDesc" name="ProgramDesc" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="addDeptId" class="form-label">Department</label>
                        <select class="form-select" id="addDeptId" name="DeptId">
                            <option value="">No Department</option>
                            <!-- Departments will be populated via JavaScript -->
                        </select>
                        <div class="form-text">Select the department this program belongs to</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveProgram">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Program
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Program Modal -->
<div class="modal fade" id="editProgramModal" tabindex="-1" aria-labelledby="editProgramModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProgramModalLabel">Edit Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editProgramForm">
                    <input type="hidden" id="editProgramId" name="ProgramId">
                    <div class="mb-3">
                        <label for="editProgramCode" class="form-label">Program Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editProgramCode" name="ProgramCode" required maxlength="10">
                    </div>
                    <div class="mb-3">
                        <label for="editProgramName" class="form-label">Program Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editProgramName" name="ProgramName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="editProgramDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="editProgramDesc" name="ProgramDesc" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editDeptId" class="form-label">Department</label>
                        <select class="form-select" id="editDeptId" name="DeptId">
                            <option value="">No Department</option>
                            <!-- Departments will be populated via JavaScript -->
                        </select>
                        <div class="form-text">Select the department this program belongs to</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateProgram">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Program
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteProgramModal" tabindex="-1" aria-labelledby="deleteProgramModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteProgramModalLabel">Delete Program?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this program?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteProgramId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/program.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/program.css" asp-append-version="true"/>
