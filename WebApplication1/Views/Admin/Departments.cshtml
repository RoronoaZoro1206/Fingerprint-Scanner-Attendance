@{
    ViewData["Title"] = "Departments";
}

<div class="page-header">
    <h1 class="page-title">Manage Departments</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddDepartment">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Department
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="departmentsTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Department Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDepartmentModalLabel">Add New Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addDepartmentForm">
                    <div class="mb-3">
                        <label for="addDeptCode" class="form-label">Department Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addDeptCode" name="DeptCode" required maxlength="10">
                        <div class="form-text">e.g., CS, IT, ENG</div>
                    </div>
                    <div class="mb-3">
                        <label for="addDeptName" class="form-label">Department Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addDeptName" name="DeptName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="addDeptDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="addDeptDesc" name="DeptDesc" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveDepartment">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Department
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editDepartmentModalLabel">Edit Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editDepartmentForm">
                    <input type="hidden" id="editDeptId" name="DeptId">
                    <div class="mb-3">
                        <label for="editDeptCode" class="form-label">Department Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editDeptCode" name="DeptCode" required maxlength="10">
                    </div>
                    <div class="mb-3">
                        <label for="editDeptName" class="form-label">Department Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editDeptName" name="DeptName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="editDeptDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="editDeptDesc" name="DeptDesc" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateDepartment">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Department
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-labelledby="deleteDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteDepartmentModalLabel">Delete Department?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this department?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteDeptId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/department.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/department.css" asp-append-version="true"/>

