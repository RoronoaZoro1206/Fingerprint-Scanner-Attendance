@{
    ViewData["Title"] = "Courses";
}

<div class="page-header">
    <h1 class="page-title">Manage Courses</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddCourse">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Course
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="coursesTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Units</th>
                        <th>Program</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Course Modal -->
<div class="modal fade" id="addCourseModal" tabindex="-1" aria-labelledby="addCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCourseModalLabel">Add New Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addCourseForm">
                    <div class="mb-3">
                        <label for="addCourseCode" class="form-label">Course Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addCourseCode" name="CourseCode" required maxlength="10">
                        <div class="form-text">e.g., CS101, IT201, ENG301</div>
                    </div>
                    <div class="mb-3">
                        <label for="addCourseName" class="form-label">Course Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="addCourseName" name="CourseName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="addCourseUnits" class="form-label">Units <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="addCourseUnits" name="CourseUnits" required min="1" max="10" value="3">
                    </div>
                    <div class="mb-3">
                        <label for="addProgramId" class="form-label">Program</label>
                        <select class="form-select" id="addProgramId" name="ProgramId">
                            <option value="">Select Program (Optional)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addCourseDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="addCourseDesc" name="CourseDesc" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveCourse">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Course
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Course Modal -->
<div class="modal fade" id="editCourseModal" tabindex="-1" aria-labelledby="editCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCourseModalLabel">Edit Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCourseForm">
                    <input type="hidden" id="editCourseId" name="CourseId">
                    <div class="mb-3">
                        <label for="editCourseCode" class="form-label">Course Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editCourseCode" name="CourseCode" required maxlength="10">
                    </div>
                    <div class="mb-3">
                        <label for="editCourseName" class="form-label">Course Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editCourseName" name="CourseName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="editCourseUnits" class="form-label">Units <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editCourseUnits" name="CourseUnits" required min="1" max="10">
                    </div>
                    <div class="mb-3">
                        <label for="editProgramId" class="form-label">Program</label>
                        <select class="form-select" id="editProgramId" name="ProgramId">
                            <option value="">Select Program (Optional)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editCourseDesc" class="form-label">Description</label>
                        <textarea class="form-control" id="editCourseDesc" name="CourseDesc" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateCourse">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Course
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-labelledby="deleteCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteCourseModalLabel">Delete Course?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this course?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteCourseId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/course.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/course.css" asp-append-version="true"/>
