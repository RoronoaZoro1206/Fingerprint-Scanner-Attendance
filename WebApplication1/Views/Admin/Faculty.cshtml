@{
    ViewData["Title"] = "Faculties";
}

<div class="page-header">
    <h1 class="page-title">Manage Faculties</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnAddFaculty">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Faculty
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="facultiesTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Rank</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Faculty Modal -->
<div class="modal fade" id="addFacultyModal" tabindex="-1" aria-labelledby="addFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addFacultyModalLabel">Add New Faculty</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addFacultyForm">
                    <div class="mb-3">
                        <label for="addUserId" class="form-label">Faculty User <span class="text-danger">*</span></label>
                        <select class="form-select" id="addUserId" name="UserId" required>
                            <option value="">Select a user...</option>
                        </select>
                        <div class="form-text">Select a user with Faculty role</div>
                    </div>
                    <div class="mb-3">
                        <label for="addDeptId" class="form-label">Department</label>
                        <select class="form-select" id="addDeptId" name="DeptId">
                            <option value="">No Department</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addFacRank" class="form-label">Rank</label>
                        <input type="text" class="form-control" id="addFacRank" name="FacRank" maxlength="50" placeholder="e.g., Professor, Associate Professor">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveFaculty">
                    <i data-lucide="save" class="icon-sm"></i>
                    Save Faculty
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Faculty Modal -->
<div class="modal fade" id="editFacultyModal" tabindex="-1" aria-labelledby="editFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editFacultyModalLabel">Edit Faculty</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editFacultyForm">
                    <input type="hidden" id="editFacId" name="FacId">
                    <input type="hidden" id="editUserId" name="UserId">
                    <div class="mb-3">
                        <label for="editUserEmail" class="form-label">Faculty User</label>
                        <input type="text" class="form-control" id="editUserEmail" readonly disabled>
                        <div class="form-text">User cannot be changed</div>
                    </div>
                    <div class="mb-3">
                        <label for="editDeptId" class="form-label">Department</label>
                        <select class="form-select" id="editDeptId" name="DeptId">
                            <option value="">No Department</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editFacRank" class="form-label">Rank</label>
                        <input type="text" class="form-control" id="editFacRank" name="FacRank" maxlength="50" placeholder="e.g., Professor, Associate Professor">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateFaculty">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Faculty
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteFacultyModal" tabindex="-1" aria-labelledby="deleteFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteFacultyModalLabel">Delete Faculty?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this faculty record?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deleteFacId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/faculty.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/faculty.css" asp-append-version="true"/>
