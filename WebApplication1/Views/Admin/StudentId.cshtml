@{
    ViewData["Title"] = "Student ID Pool";
}

<div class="page-header">
    <h1 class="page-title">Student ID Pool</h1>
    <div class="header-actions">
        <button type="button" class="btn btn-outline btn-print" id="btnPrint">
            <i data-lucide="printer" class="icon-sm"></i>
            Print
        </button>
        <div class="dropdown">
            <button class="btn btn-outline dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="download" class="icon-sm"></i>
                Export
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                <li>
                    <a class="dropdown-item" href="#" id="btnExportExcel">
                        <i data-lucide="file-spreadsheet" class="icon-sm"></i>
                        Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportCSV">
                        <i data-lucide="file-text" class="icon-sm"></i>
                        CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="btnExportPDF">
                        <i data-lucide="file" class="icon-sm"></i>
                        PDF
                    </a>
                </li>
            </ul>
        </div>
        <button type="button" class="btn btn-primary btn-add" id="btnGenerateIds">
            <i data-lucide="hash" class="icon-sm"></i>
            Generate IDs
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="studentIdPoolTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Status</th>
                        <th>Generated At</th>
                        <th>Used At</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Generate Student IDs Modal -->
<div class="modal fade" id="generateIdsModal" tabindex="-1" aria-labelledby="generateIdsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="generateIdsModalLabel">Generate Student IDs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="generateIdsForm">
                    <div class="mb-3">
                        <label for="genYear" class="form-label">Year <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="genYear" name="Year" required min="2000" max="2100">
                        <div class="form-text">e.g., 2025</div>
                    </div>
                    <div class="mb-3">
                        <label for="genStartNumber" class="form-label">Start Number <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="genStartNumber" name="StartNumber" required min="1" max="9999">
                        <div class="form-text">Starting sequence number (e.g., 1 for 2025-0001)</div>
                    </div>
                    <div class="mb-3">
                        <label for="genCount" class="form-label">Count <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="genCount" name="Count" required min="1" max="1000">
                        <div class="form-text">Number of IDs to generate (max 1000)</div>
                    </div>
                    <div class="mb-3">
                        <label for="genRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="genRemarks" name="Remarks" rows="2" maxlength="500" placeholder="Optional notes about this batch"></textarea>
                    </div>
                    <div class="alert alert-info mb-0">
                        <i data-lucide="info" class="icon-sm"></i>
                        <strong>Preview:</strong> <span id="previewText">Enter values to see preview</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnConfirmGenerate">
                    <i data-lucide="hash" class="icon-sm"></i>
                    Generate IDs
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Remarks Modal -->
<div class="modal fade" id="editRemarksModal" tabindex="-1" aria-labelledby="editRemarksModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRemarksModalLabel">Edit Remarks</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editRemarksForm">
                    <input type="hidden" id="editPoolId" name="PoolId">
                    <div class="mb-3">
                        <label for="editStudentIdCode" class="form-label">Student ID</label>
                        <input type="text" class="form-control" id="editStudentIdCode" readonly disabled>
                    </div>
                    <div class="mb-3">
                        <label for="editRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="editRemarks" name="Remarks" rows="3" maxlength="500"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdateRemarks">
                    <i data-lucide="save" class="icon-sm"></i>
                    Update Remarks
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteIdModal" tabindex="-1" aria-labelledby="deleteIdModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2" id="deleteIdModalLabel">Delete Student ID?</h5>
                <p class="text-muted mb-0">Are you sure you want to delete this student ID?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="deletePoolId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">
                    <i data-lucide="trash-2" class="icon-sm"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student_id_pool.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/admin/student_id_pool.css" asp-append-version="true"/>
