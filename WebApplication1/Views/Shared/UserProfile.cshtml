@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">
    <!-- Profile Header Card -->
    <div class="profile-header-card">
        <div class="profile-header-content">
            <div class="profile-picture-container">
                <div class="profile-picture-wrapper">
                    <!-- ✅ FIX: Added onerror handler to fallback to default_profile.png -->
                    <img src="~/images/profile/templates/default_profile.png" 
                         alt="Profile Picture" 
                         id="profilePicturePreview" 
                         class="profile-picture" 
                         onerror="this.onerror=null; this.src='/images/profile/templates/default_profile.png';" />
                    <button type="button" class="btn-change-photo" id="btnChangePicture">
                        <i data-lucide="camera"></i>
                    </button>
                    <input type="file" id="profilePictureInput" accept="image/*" style="display: none;" />
                </div>
            </div>
            <div class="profile-header-info">
                <h1 class="profile-name" id="profileDisplayName">Loading...</h1>
                <p class="profile-email" id="profileDisplayEmail">Loading...</p>
            </div>
        </div>
    </div>

    <!-- Profile Form Card -->
    <div class="profile-form-card">
        <form id="profileForm">
            <!-- Personal Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">Personal Information</h2>
                    <p class="section-description">Update your personal details</p>
                </div>
                
                <div class="form-grid">
                    <div class="form-group">
                        <label for="firstName" class="form-label">First Name <span class="required">*</span></label>
                        <input type="text" class="form-input" id="firstName" placeholder="Enter first name" required maxlength="50" />
                    </div>
                    
                    <div class="form-group">
                        <label for="middleName" class="form-label">Middle Name</label>
                        <input type="text" class="form-input" id="middleName" placeholder="Enter middle name" maxlength="50" />
                    </div>
                    
                    <div class="form-group">
                        <label for="lastName" class="form-label">Last Name <span class="required">*</span></label>
                        <input type="text" class="form-input" id="lastName" placeholder="Enter last name" required maxlength="50" />
                    </div>
                    
                    <div class="form-group">
                        <label for="gender" class="form-label">Gender</label>
                        <select class="form-input" id="gender">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="birthdate" class="form-label">Birthdate</label>
                        <input type="date" class="form-input" id="birthdate" max="9999-12-31" />
                    </div>
                    
                    <div class="form-group">
                        <label for="phone" class="form-label">Phone Number</label>
                        <input type="tel" class="form-input" id="phone" placeholder="Enter phone number" maxlength="20" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="address" class="form-label">Address</label>
                    <textarea class="form-input" id="address" rows="3" placeholder="Enter your address" maxlength="200"></textarea>
                </div>
            </div>

            <!-- Account Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">Account Information</h2>
                    <p class="section-description">Your account details</p>
                </div>
                
                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" class="form-input" id="email" readonly />
                    <p class="form-hint">Email address cannot be changed</p>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="btnCancel">
                    <i data-lucide="x"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary" id="btnSave">
                    <i data-lucide="check"></i>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/user_profile.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/user_profile.css" asp-append-version="true"/>
