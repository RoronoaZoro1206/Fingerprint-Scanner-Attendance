@{
    var userName = Context.Session.GetString("UserName") ?? "User";
    var userImage = Context.Session.GetString("UserProfileImage") ?? "default_profile.png";
}

<!-- Desktop Sidebar -->
<aside class="sidebar d-none d-lg-flex">
    <div class="sidebar-header">
        <div class="user-profile">
            <img src="~/images/profile/@userImage" alt="Profile" class="profile-image" />
            <div class="user-details">
                <span class="user-name">@userName</span>
                <span class="user-role">Admin</span>
            </div>
        </div>
    </div>
    
    <nav class="sidebar-nav">
        <a href="@Url.Action("Index", "Admin")" class="sidebar-link">
            <i data-lucide="layout-dashboard"></i>
            <span>Overview</span>
        </a>
        
        <a href="@Url.Action("ManageUsers", "Admin")" class="sidebar-link">
            <i data-lucide="users"></i>
            <span>Manage Users</span>
        </a>
        
        <a href="@Url.Action("Programs", "Admin")" class="sidebar-link">
            <i data-lucide="book-open"></i>
            <span>Programs</span>
        </a>
        
        <a href="@Url.Action("Courses", "Admin")" class="sidebar-link">
            <i data-lucide="graduation-cap"></i>
            <span>Courses</span>
        </a>
        
        <a href="@Url.Action("Faculty", "Admin")" class="sidebar-link">
            <i data-lucide="user-check"></i>
            <span>Faculty</span>
        </a>
        
        <a href="@Url.Action("StudentId", "Admin")" class="sidebar-link">
            <i data-lucide="credit-card"></i>
            <span>Student ID</span>
        </a>
        
        <a href="@Url.Action("Students", "Admin")" class="sidebar-link">
            <i data-lucide="users-2"></i>
            <span>Students</span>
        </a>
        
        <a href="@Url.Action("RoomsAndClasses", "Admin")" class="sidebar-link">
            <i data-lucide="door-open"></i>
            <span>Rooms & Classes</span>
        </a>
        
        <a href="@Url.Action("RegisterFingerprint", "Admin")" class="sidebar-link">
            <i data-lucide="fingerprint"></i>
            <span>Register Fingerprint</span>
        </a>
        
        <a href="@Url.Action("AuditLogs", "Admin")" class="sidebar-link">
            <i data-lucide="file-text"></i>
            <span>Audit Logs</span>
        </a>
    </nav>
</aside>

<!-- Mobile Offcanvas Sidebar -->
<div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
    <div class="offcanvas-header">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="sidebar-header">
            <div class="user-profile">
                <img src="~/images/profile/@userImage" alt="Profile" class="profile-image" />
                <div class="user-details">
                    <span class="user-name">@userName</span>
                    <span class="user-role">Admin</span>
                </div>
            </div>
        </div>
        
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="layout-dashboard"></i>
                <span>Overview</span>
            </a>
            
            <a href="@Url.Action("ManageUsers", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="users"></i>
                <span>Manage Users</span>
            </a>
            
            <a href="@Url.Action("Programs", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="book-open"></i>
                <span>Programs</span>
            </a>
            
            <a href="@Url.Action("Courses", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="graduation-cap"></i>
                <span>Courses</span>
            </a>
            
            <a href="@Url.Action("Faculty", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="user-check"></i>
                <span>Faculty</span>
            </a>
            
            <a href="@Url.Action("StudentId", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="credit-card"></i>
                <span>Student ID</span>
            </a>
            
            <a href="@Url.Action("Students", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="users-2"></i>
                <span>Students</span>
            </a>
            
            <a href="@Url.Action("RoomsAndClasses", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="door-open"></i>
                <span>Rooms & Classes</span>
            </a>
            
            <a href="@Url.Action("RegisterFingerprint", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="fingerprint"></i>
                <span>Register Fingerprint</span>
            </a>
            
            <a href="@Url.Action("AuditLogs", "Admin")" class="sidebar-link" data-bs-dismiss="offcanvas">
                <i data-lucide="file-text"></i>
                <span>Audit Logs</span>
            </a>
        </nav>
    </div>
</div>
