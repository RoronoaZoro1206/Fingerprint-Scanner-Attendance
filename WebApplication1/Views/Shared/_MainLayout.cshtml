<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - School Attendance System</title>
    @await Html.PartialAsync("_HeadPartial")
    <link rel="stylesheet" href="~/css/main-layout.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/fingerprint-prompt.css" asp-append-version="true"/>
    <!-- Common Styles (Shared across all modules) -->
    @await Html.PartialAsync("_CommonStyles")
</head>
<body data-role-id="@Context.Session.GetInt32("RoleId")">
    <div class="app-container">
        <!-- Sidebar -->
        @{
            var roleId = Context.Session.GetInt32("RoleId");
            if (roleId == 1)
            {
                await Html.RenderPartialAsync("_AdminSidebarPartial");
            }
            else if (roleId == 2)
            {
                await Html.RenderPartialAsync("_FacultySidebarPartial");
            }
            else if (roleId == 3)
            {
                await Html.RenderPartialAsync("_StudentSidebarPartial");
            }
        }

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            @await Html.PartialAsync("_MainNavbarPartial")

            <!-- Content Section -->
            <div class="content-section">
                @RenderBody()
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_LayoutScripts")
    <script src="~/js/fingerprint-prompt.js" asp-append-version="true"></script>
    <!-- Common JavaScript Utilities (Shared across all modules) -->
    @await Html.PartialAsync("_CommonScripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
