@{
    ViewData["Title"] = "My Attendance Record";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="page-header">
    <h1 class="page-title">My Attendance Record</h1>
</div>

<!-- Statistics Cards -->
<div class="stats-grid" id="statsGrid">
    <!-- Stats will be loaded here -->
</div>

<!-- Recent Attendance History -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Recent Attendance History</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="attendanceTable" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Course</th>
                        <th>Status</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student/student_attendance.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/student/student_attendance.css" asp-append-version="true"/>
