@{
    ViewData["Title"] = "Register Fingerprint";
}

<div class="register-fingerprint-page">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Register Fingerprint</h1>
        <p class="page-description">Securely register your fingerprint biometric data for login</p>
    </div>

    <!-- Status Cards Row -->
    <div class="status-cards-row">
        <!-- Scanner Status Card -->
        <div class="status-card">
            <div class="status-header">
                <div class="status-icon online">
                    <i data-lucide="wifi"></i>
                </div>
                <div class="status-info">
                    <h3 class="status-title">Scanner Status</h3>
                    <p class="status-value online" id="scannerStatus">Online</p>
                </div>
            </div>
        </div>

        <!-- Registration Status Card -->
        <div class="status-card">
            <div class="status-header">
                <div class="status-icon pending">
                    <i data-lucide="fingerprint"></i>
                </div>
                <div class="status-info">
                    <h3 class="status-title">Registration Status</h3>
                    <p class="status-value pending" id="registrationStatus">Not Registered</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Scanner Card -->
    <div class="scanner-card">
        <!-- User Icon Badge -->
        <div class="user-icon-badge">
            <i data-lucide="user"></i>
        </div>

        <!-- Scanner Box -->
        <div class="scanner-box">
            <!-- Fingerprint Scanner Circle -->
            <div class="fingerprint-scanner" id="fingerprintScanner">
                <i data-lucide="fingerprint" class="fingerprint-icon"></i>
            </div>

            <!-- Scan Button -->
            <button type="button" class="btn-scan" id="btnScan">
                Scan Fingerprint
            </button>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button type="button" class="btn-register" id="btnRegister">
                <i data-lucide="shield-check"></i>
                Register Fingerprint
            </button>
            <button type="button" class="btn-cancel" id="btnCancel">
                Cancel
            </button>
        </div>
    </div>

    <!-- Info Cards Row -->
    <div class="info-cards-row">
        <!-- Security Info -->
        <div class="info-card">
            <div class="info-icon">
                <i data-lucide="shield-check"></i>
            </div>
            <p class="info-text">All biometric data is encrypted and stored securely in compliance with privacy regulations.</p>
        </div>

        <!-- Quick Tips -->
        <div class="info-card">
            <h3 class="info-title">Quick Tips</h3>
            <ul class="tips-list">
                <li>• Ensure finger is clean and dry</li>
                <li>• Place finger flat on the scanner</li>
                <li>• Hold steady during scanning</li>
                <li>• Try different fingers if scan fails</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student_register_fingerprint.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/student_register_fingerprint.css" asp-append-version="true"/>
