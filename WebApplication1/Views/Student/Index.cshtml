@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h1 class="page-title">My Profile</h1>
</div>

<!-- Profile Section -->
<div class="profile-container">
    <!-- Profile Card -->
    <div class="profile-card">
        <div class="profile-header">
   <div class="profile-avatar-section">
  <div class="profile-avatar">
 <!-- ✅ FIX: Use templates/default_profile.png as default and add error handler -->
 <img id="profileImage" src="/images/profile/templates/default_profile.png" alt="Profile Picture" 
      onerror="this.onerror=null; this.src='/images/profile/templates/default_profile.png';">
    </div>
           <div class="profile-basic-info">
           <h2 id="profileName" class="profile-name">Loading...</h2>
       <p id="profileEmail" class="profile-email">Loading...</p>
     <span id="profileStudentNumber" class="profile-student-number"></span>
         </div>
 </div>
   </div>

        <form id="profileForm">
            <!-- Personal Information Section -->
            <div class="form-section">
     <h3 class="section-title">
        <i data-lucide="user" class="section-icon"></i>
   Personal Information
     </h3>
        <div class="form-grid">
    <div class="form-group">
   <label for="firstName" class="form-label">First Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="firstName" required>
   </div>
 <div class="form-group">
     <label for="middleName" class="form-label">Middle Name</label>
        <input type="text" class="form-control" id="middleName">
     </div>
                  <div class="form-group">
   <label for="lastName" class="form-label">Last Name <span class="text-danger">*</span></label>
       <input type="text" class="form-control" id="lastName" required>
         </div>
         <div class="form-group">
        <label for="gender" class="form-label">Gender</label>
         <select class="form-select" id="gender">
             <option value="">Select Gender...</option>
    <option value="Male">Male</option>
           <option value="Female">Female</option>
                   <option value="Other">Other</option>
         </select>
             </div>
         <div class="form-group">
  <label for="birthdate" class="form-label">Birthdate</label>
   <input type="date" class="form-control" id="birthdate" max="9999-12-31">
      </div>
            <div class="form-group">
       <label for="phone" class="form-label">Phone Number</label>
                  <input type="tel" class="form-control" id="phone">
          </div>
                </div>
         <div class="form-group">
           <label for="address" class="form-label">Address</label>
        <textarea class="form-control" id="address" rows="3"></textarea>
        </div>
</div>

    <!-- Academic Information Section -->
         <div class="form-section">
      <h3 class="section-title">
           <i data-lucide="graduation-cap" class="section-icon"></i>
     Academic Information
       </h3>
       <!-- ✅ READ-ONLY NOTICE: Students cannot modify academic information -->
       <div class="alert alert-info" style="margin-bottom: 1rem;">
           <i data-lucide="info" style="width: 16px; height: 16px; vertical-align: middle;"></i>
           <strong>Academic Information</strong><br>
           Your academic information (Program, Year Level, Section) is managed by the administration office. 
           Contact your administrator if you need to make changes.
       </div>
    <div class="form-grid">
    <div class="form-group">
   <label for="program" class="form-label">Program</label>
   <!-- ✅ CHANGED: Disabled select field - students cannot edit -->
   <select class="form-select" id="program" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
      <option value="">Select Program...</option>
   </select>
      <small class="form-text">Managed by administration</small>
      </div>
        <div class="form-group">
         <label for="yearLevel" class="form-label">Year Level</label>
         <!-- ✅ CHANGED: Disabled select field - students cannot edit -->
          <select class="form-select" id="yearLevel" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
      <option value="">Select Year Level...</option>
  <option value="1">1st Year</option>
        <option value="2">2nd Year</option>
      <option value="3">3rd Year</option>
                 <option value="4">4th Year</option>
         </select>
         <small class="form-text">Managed by administration</small>
        </div>
        <div class="form-group">
       <label for="section" class="form-label">Section</label>
       <!-- ✅ CHANGED: Disabled select field - students cannot edit -->
            <select class="form-select" id="section" disabled style="background-color: #f5f5f5; cursor: not-allowed;">
             <option value="">Select Section...</option>
       </select>
       <small class="form-text">Managed by administration</small>
    </div>
         </div>
  </div>

      <!-- Action Buttons -->
  <div class="form-actions">
  <button type="button" class="btn btn-secondary" onclick="loadProfile()">
             <i data-lucide="rotate-ccw" class="icon-sm"></i>
              Reset
            </button>
          <button type="submit" class="btn btn-primary" id="btnSaveProfile">
        <i data-lucide="save" class="icon-sm"></i>
           Save Changes
   </button>
            </div>
    </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/student/student_profile.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/student/student_profile.css" asp-append-version="true"/>

<style>
    .form-select:disabled,
    .form-control:disabled {
   background-color: #f5f5f5;
        cursor: not-allowed;
        opacity: 0.7;
  }
    
    .alert-info {
        background-color: #e7f3ff;
        border: 1px solid #b3d9ff;
        border-radius: 8px;
        padding: 12px 16px;
        color: #004085;
    }
    
  .alert-info i {
        margin-right: 8px;
 }
    
    .lock-icon-wrapper {
        width: 80px;
        height: 80px;
      margin: 0 auto;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .lock-icon {
  width: 40px;
        height: 40px;
        color: white;
        stroke-width: 2;
    }
</style>
