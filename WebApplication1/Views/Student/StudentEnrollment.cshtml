@{
    ViewData["Title"] = "Manage Enrollments";
}

<div class="page-header">
    <h1 class="page-title">Manage Enrollments</h1>
</div>

<!-- Current Enrollments Section -->
<div class="enrollment-section">
    <div class="section-header">
        <div class="section-title">
            <i data-lucide="book-open" class="section-icon"></i>
            <span>Current Enrollments</span>
        </div>
        <span class="enrollment-count" id="currentCount">0 Classes</span>
    </div>
    <p class="section-description" id="currentDescription">Classes that you are currently enrolled in</p>

    <div id="currentEnrollments" class="enrollments-container">
        <!-- Current enrollments will be loaded here -->
    </div>
</div>

<!-- Available Classes Section -->
<div class="enrollment-section">
    <div class="section-header">
        <div class="section-title">
            <i data-lucide="list" class="section-icon"></i>
            <span>Available Classes</span>
        </div>
        <span class="enrollment-count" id="availableCount">0 Classes</span>
    </div>
    <p class="section-description" id="availableDescription">Classes available for enrollment (filtered by your program)</p>

    <div id="availableClasses" class="enrollments-container">
        <!-- Available classes will be loaded here -->
    </div>
</div>

<!-- Unenroll Confirmation Modal -->
<div class="modal fade" id="unenrollModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center pt-0">
                <div class="mb-3">
                    <div class="delete-icon-wrapper">
                        <i data-lucide="alert-triangle" class="delete-icon"></i>
                    </div>
                </div>
                <h5 class="modal-title mb-2">Unenroll from Class?</h5>
                <p class="text-muted mb-0">Are you sure you want to unenroll from this class?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <input type="hidden" id="unenrollId">
            </div>
            <div class="modal-footer border-0 justify-content-center gap-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmUnenroll">
                    <i data-lucide="x-circle" class="icon-sm"></i>
                    Unenroll
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student/student_enroll.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/student/student_enroll.css" asp-append-version="true"/>
