@{
    ViewData["Title"] = "Biometric Login";
}

<div class="auth-container">
    <div class="auth-card fingerprint-card">
        <a href="@Url.Action("Index", "Auth")" class="back-to-login">
            <i data-lucide="arrow-left"></i>
            Back to login
        </a>

        <div class="fingerprint-header">
            <h1 class="fingerprint-title">Biometric Attendance</h1>
            <p class="fingerprint-subtitle">Scan your fingerprint to login</p>
        </div>

        <div class="fingerprint-scanner">
            <div class="scanner-circle">
                <i data-lucide="fingerprint" size="200"></i>
            </div>
        </div>

        <p class="scanner-instruction">Place your finger on the scanner</p>

        <button type="button" class="start-scan-btn" id="startScanBtn">
            Start Scan
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/fingerprint-scan.js"></script>
}
