@model Fingerprint_Attendance_System.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container">
    <div class="auth-card register-card">
        <div class="auth-header">
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Register to access the attendance system</p>
        </div>

        <div class="login-form-container">
            <form class="login-form register-form" method="post" asp-action="Register" asp-controller="Auth">
                <div class="form-group">
                    <label class="form-label" asp-for="StudentId">Student ID</label>
                    <input type="text" class="form-input" placeholder="Enter your student ID" asp-for="StudentId" required />
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" asp-for="FirstName">First Name</label>
                        <input type="text" class="form-input" placeholder="First name" asp-for="FirstName" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="LastName">Last Name</label>
                        <input type="text" class="form-input" placeholder="Last name" asp-for="LastName" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input type="email" class="form-input" placeholder="Enter your email" asp-for="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Password">Password</label>
                    <div class="password-input-container">
                        <input type="text" class="form-input" placeholder="Create a password" asp-for="Password" required />
                        <button type="button" class="password-toggle" id="togglePassword"></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="password-input-container">
                        <input type="password" class="form-input" placeholder="Confirm your password" asp-for="ConfirmPassword" required />
                        <button type="button" class="password-toggle" id="toggleConfirmPassword">
                            <i data-lucide="eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="sign-in-btn">Create Account</button>
            </form>

            <div class="register-link">
                Already have an account?
                <a href="@Url.Action("Index", "Auth")">Sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/register-toggle-password.js"></script>
    <script src="~/js/register-ajax.js"></script>
}
